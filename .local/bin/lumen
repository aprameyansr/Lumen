#!/bin/sh
#
# lumen — Control CLI for the Lumen shell.
#
# Thin wrapper over the Quickshell surface, its watchdog and the dotfiles sync.
# The watchdog is what keeps the surface alive: it reruns `qs` a second after the
# instance dies. So `stop` has to take the watchdog down too or the surface just
# comes back, while `restart` leaves the watchdog running and only cycles the instance.
#
#   lumen restart                 Restart the shell
#   lumen start                   Start the watchdog
#   lumen stop                    Stop watchdog + shell
#   lumen log                     Follow the Quickshell log
#   lumen status                  What's running and the installed version
#   lumen sync                    Copy the live configs into the dotfiles repo

SCRIPTS="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts"
WATCHDOG="$SCRIPTS/watchdog.sh"

# The installer's Hanko skin: a vermilion edge marker, a quiet connector gutter
# and Lumen's ember palette. Dropped whole when stdout is not a terminal or
# NO_COLOR is set, so a pipe gets clean plain text.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    verm=$(printf '\033[38;2;192;68;43m')
    flame=$(printf '\033[38;2;255;154;100m')
    cream=$(printf '\033[38;2;230;214;203m')
    bright=$(printf '\033[38;2;255;246;240m')
    dim=$(printf '\033[38;2;138;125;116m')
    faint=$(printf '\033[38;2;111;99;91m')
    rst=$(printf '\033[0m')
else
    verm=""
    flame=""
    cream=""
    bright=""
    dim=""
    faint=""
    rst=""
fi

# A section header: the vermilion edge marker and a cream title.
sec() { printf '\n  %s▌%s %s%s%s\n' "$verm" "$rst" "$cream" "$1" "$rst"; }

# A bare connector bar that breathes between rows.
gap() { printf '  %s▏%s\n' "$faint" "$rst"; }

# A content line hung on the connector gutter (the segment arrives pre-coloured).
row() { printf '  %s▏%s  %s\n' "$faint" "$rst" "$1"; }

# A one-off action: the ember done marker, the verb in cream, what it touched bright.
act() {
    printf '  %s▫%s %s%s%s %s%s%s\n' \
        "$flame" "$rst" "$cream" "$1" "$rst" "$bright" "$2" "$rst"
}

note() {
    printf '  %s▫%s %s%s%s\n' \
        "$faint" "$rst" "$dim" "$*" "$rst"
}

die() {
    printf '  %s▌%s %s%s%s\n' \
        "$verm" "$rst" "$verm" "$*" "$rst" >&2
    exit 1
}

# One help row: command flame, its argument dim, the description cream.
urow() {
    row "$(printf '%s%-8s%s %s%-16s%s %s%-30s%s %s%s%s' \
        "$flame" "$1" "$rst" \
        "$dim" "$2" "$rst" \
        "$cream" "$3" "$rst" \
        "$faint" "$4" "$rst")"
}

usage() {
    sec "Lumen · Control the Shell"
    gap
    urow restart "" "Restart the shell" ""
    urow start   "" "Start the watchdog" ""
    urow stop    "" "Stop watchdog and shell" ""
    urow log     "" "Follow the Quickshell log" ""
    urow status  "" "What's running and the version" ""
    urow sync    "" "Copy configs into the dotfiles" ""
    gap
}

is_up() { qs ipc show >/dev/null 2>&1; }
wd_up() { pgrep -f "watchdog.sh" >/dev/null 2>&1; }

# Launch a detached watchdog. A second one hits the flock in watchdog.sh and
# exits at once, so this is safe to call when one already runs.
start_wd() { setsid sh "$WATCHDOG" >/dev/null 2>&1 & }

# The dotfiles commit the live configs were last synced against.
installed_version() {
    dot="${LUMEN_DOTFILES:-$HOME/lumen}"
    sha=$(git -C "$dot" rev-parse --short HEAD 2>/dev/null)

    if [ -n "$sha" ]; then
        printf 'dotfiles %s' "$sha"
    else
        printf 'unknown'
    fi
}

cmd_start() {
    if wd_up; then
        note "Watchdog already running"
    else
        start_wd
        act "Started" "Watchdog"
    fi
}

cmd_stop() {
    pkill -f "watchdog.sh" 2>/dev/null
    qs kill >/dev/null 2>&1
    act "Stopped" "Shell"
}

cmd_restart() {
    qs kill >/dev/null 2>&1
    wd_up || start_wd

    act "Restarted" "Shell"
}

cmd_log() {
    exec qs log -f "$@"
}

cmd_status() {
    sec "Lumen"
    gap

    if is_up; then
        mk="${flame}●${rst}"
        lab="${cream}Shell${rst}"
        stt="${cream}Running${rst}"
    else
        mk="${faint}○${rst}"
        lab="${dim}Shell${rst}"
        stt="${dim}Stopped${rst}"
    fi

    if wd_up; then
        wdt="${dim}Watchdog Up${rst}"
    else
        wdt="${faint}No Watchdog${rst}"
    fi

    row "$mk $lab   $stt   $wdt"

    gap
    row "${dim}Version${rst}   ${cream}$(installed_version)${rst}"
    gap
}

# Mirror the live configs into the dotfiles repo, laid out like $HOME
# (.config/, .local/bin/lumen, the dictation service's code under .local/share/)
# plus the root-owned bits under etc/. Backups
# (*.bak*) are never copied and are cleared from the repo copy. Zen's files go
# under a generic "<profile>" folder, since the real profile name is per machine.
# LUMEN_DOTFILES overrides the repo path.
DOTFILES="${LUMEN_DOTFILES:-$HOME/lumen}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

cmd_sync() {
    [ -d "$DOTFILES/.git" ] || die "Dotfiles repo not found ($DOTFILES)"
    command -v rsync >/dev/null 2>&1 || die "Rsync not found"

    sec "Sync · $DOTFILES"
    gap

    for dir in fastfetch fish fontconfig hypr kitty quickshell spicetify; do
        [ -d "$CFG/$dir" ] || { row "${faint}skip  .config/$dir (missing)${rst}"; continue; }
        mkdir -p "$DOTFILES/.config/$dir"
        rsync -a --delete --exclude='*.bak*' --delete-excluded \
            "$CFG/$dir/" "$DOTFILES/.config/$dir/" || die "Copy failed: .config/$dir"
        row "${flame}·${rst} ${cream}.config/$dir${rst}"
    done

    mkdir -p "$DOTFILES/.local/bin"
    rsync -a "$HOME/.local/bin/lumen" "$DOTFILES/.local/bin/" || die "Copy failed: .local/bin/lumen"
    row "${flame}·${rst} ${cream}.local/bin/lumen${rst}"

    # Dictation service: its code, setup script, tray icons and the OpenVINO
    # build files (whisper.cpp patch + encoder converter). The venv, models,
    # binaries and word list (fetched or built by setup.sh) and the personal
    # vocabulary and history never leave the machine.
    dict_src="$HOME/.local/share/lumen-dictate"
    if [ -d "$dict_src" ]; then
        mkdir -p "$DOTFILES/.local/share/lumen-dictate"
        rsync -a --delete --delete-excluded --exclude='*.bak*' \
            --include='dictated.py' --include='setup.sh' --include='icons/***' \
            --include='whisper/' --include='whisper/ov-convert/***' --exclude='*' \
            "$dict_src/" "$DOTFILES/.local/share/lumen-dictate/" || die "Copy failed: .local/share/lumen-dictate"
        row "${flame}·${rst} ${cream}.local/share/lumen-dictate${rst} ${dim}(code, icons, OpenVINO files)${rst}"
    else
        row "${faint}skip  .local/share/lumen-dictate (missing)${rst}"
    fi

    for f in mimeapps.list starship.toml; do
        [ -f "$CFG/$f" ] && cp "$CFG/$f" "$DOTFILES/.config/$f"
    done
    row "${flame}·${rst} ${cream}mimeapps.list, starship.toml${rst}"

    # GTK glass theme overrides and settings (theme, cursor, font)
    mkdir -p "$DOTFILES/.config/gtk-3.0" "$DOTFILES/.config/gtk-4.0"
    for f in gtk.css glass.css settings.ini; do
        [ -f "$CFG/gtk-3.0/$f" ] && cp "$CFG/gtk-3.0/$f" "$DOTFILES/.config/gtk-3.0/"
    done
    for f in gtk.css glass.css settings.ini; do
        [ -f "$CFG/gtk-4.0/$f" ] && cp "$CFG/gtk-4.0/$f" "$DOTFILES/.config/gtk-4.0/"
    done
    row "${flame}·${rst} ${cream}gtk-3.0, gtk-4.0${rst}"

    # Zen glass styling from the profile Zen actually launches (the Install
    # section's Default=<path>, not a profile's Default=1 flag).
    prof=$(sed -n 's/^Default=//p' "$CFG/zen/profiles.ini" 2>/dev/null | grep -vx 1 | head -n 1)
    if [ -n "$prof" ] && [ -d "$CFG/zen/$prof" ]; then
        zdst="$DOTFILES/.config/zen/<profile>"
        mkdir -p "$zdst/chrome"
        for f in userChrome.css userContent.css spotlight-blur.svg; do
            [ -f "$CFG/zen/$prof/chrome/$f" ] && cp "$CFG/zen/$prof/chrome/$f" "$zdst/chrome/"
        done
        [ -f "$CFG/zen/$prof/user.js" ] && cp "$CFG/zen/$prof/user.js" "$zdst/"
        row "${flame}·${rst} ${cream}zen${rst} ${dim}($prof)${rst}"
    else
        row "${faint}skip  zen (no default profile)${rst}"
    fi

    # Zen autoconfig (glass tooltips) and the pacman hook that restores it
    mkdir -p "$DOTFILES/etc/zen-autoconfig" "$DOTFILES/etc/pacman.d/hooks"
    for f in autoconfig.js mozilla.cfg; do
        [ -f "/etc/zen-autoconfig/$f" ] && cp "/etc/zen-autoconfig/$f" "$DOTFILES/etc/zen-autoconfig/"
    done
    [ -f /etc/pacman.d/hooks/zen-autoconfig.hook ] &&
        cp /etc/pacman.d/hooks/zen-autoconfig.hook "$DOTFILES/etc/pacman.d/hooks/"
    row "${flame}·${rst} ${cream}etc/zen-autoconfig, etc/pacman.d/hooks${rst}"

    gap
    changed=$(git -C "$DOTFILES" status --porcelain 2>/dev/null | wc -l)
    act "Synced" "$changed change(s) in the repo"
}

cmd="$1"
[ $# -gt 0 ] && shift

case "$cmd" in
    restart) cmd_restart ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    log) cmd_log "$@" ;;
    status) cmd_status ;;
    sync) cmd_sync ;;
    "" | -h | --help | help) usage ;;
    *) die "Unknown command '$cmd' (try: lumen help)" ;;
esac
