#!/bin/sh
#
# lumen — Control CLI for the Lumen shell.
#
# Thin wrapper over the Quickshell surface, its watchdog and the update engine.
# The watchdog is what keeps the surface alive: it respawns `qs -d` whenever the
# instance dies. So `stop` has to take the watchdog down too or the surface just
# comes back, while `restart` leaves the watchdog running and only cycles the instance.
#
#   lumen restart                 Restart the shell
#   lumen start                   Start the watchdog
#   lumen stop                    Stop watchdog + shell
#   lumen log                     Follow the Quickshell log
#   lumen update                  Check, show changelog, apply, restart
#   lumen status                  What's running and the installed version

SCRIPTS="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts"
ENGINE="$SCRIPTS/ricelin-update.py"
WATCHDOG="$SCRIPTS/watchdog.sh"

# The installer's Hanko skin: a vermilion edge marker, a quiet connector gutter
# and Lumen's ember palette. Dropped whole when stdout is not a terminal or
# NO_COLOR is set, so a pipe gets clean plain text.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    verm=$(printf '\033[38;2;192;68;43m')
    flame=$(printf '\033[38;2;255;154;100m')
    cream=$(printf '\033[38;2;230;214;203m')
    bright=$(printf '\033[38;2;255;246;240m')
    dim=$(printf '\033[38;2;138;125;116m')
    faint=$(printf '\033[38;2;111;99;91m')
    rst=$(printf '\033[0m')
else
    verm=""
    flame=""
    cream=""
    bright=""
    dim=""
    faint=""
    rst=""
fi

# A section header: the vermilion edge marker and a cream title.
sec() { printf '\n  %s▌%s %s%s%s\n' "$verm" "$rst" "$cream" "$1" "$rst"; }

# A bare connector bar that breathes between rows.
gap() { printf '  %s▏%s\n' "$faint" "$rst"; }

# A content line hung on the connector gutter (the segment arrives pre-coloured).
row() { printf '  %s▏%s  %s\n' "$faint" "$rst" "$1"; }

# A one-off action: the ember done marker, the verb in cream, what it touched bright.
act() {
    printf '  %s▫%s %s%s%s %s%s%s\n' \
        "$flame" "$rst" "$cream" "$1" "$rst" "$bright" "$2" "$rst"
}

note() {
    printf '  %s▫%s %s%s%s\n' \
        "$faint" "$rst" "$dim" "$*" "$rst"
}

die() {
    printf '  %s▌%s %s%s%s\n' \
        "$verm" "$rst" "$verm" "$*" "$rst" >&2
    exit 1
}

# One help row: command flame, its argument dim, the description cream.
urow() {
    row "$(printf '%s%-8s%s %s%-16s%s %s%-30s%s %s%s%s' \
        "$flame" "$1" "$rst" \
        "$dim" "$2" "$rst" \
        "$cream" "$3" "$rst" \
        "$faint" "$4" "$rst")"
}

usage() {
    sec "Lumen · Control the Shell"
    gap
    urow restart "" "Restart the shell" ""
    urow start   "" "Start the watchdog" ""
    urow stop    "" "Stop watchdog and shell" ""
    urow log     "" "Follow the Quickshell log" ""
    urow update  "" "Check, then apply an update" ""
    urow status  "" "What's running and the version" ""
    gap
}

is_up() { qs ipc show >/dev/null 2>&1; }
wd_up() { pgrep -f "watchdog.sh" >/dev/null 2>&1; }

# Launch a detached watchdog. A second one hits the flock in watchdog.sh and
# exits at once, so this is safe to call when one already runs.
start_wd() { setsid sh "$WATCHDOG" >/dev/null 2>&1 & }

installed_version() {
    qsdir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"

    if [ -L "$qsdir" ]; then
        repo=$(git -C "$(readlink -f "$qsdir")" rev-parse --show-toplevel 2>/dev/null)

        if [ -n "$repo" ]; then
            printf 'dev %s' \
                "$(git -C "$repo" rev-parse --short HEAD 2>/dev/null)"
            return
        fi
    fi

    mf="${XDG_STATE_HOME:-$HOME/.local/state}/ricelin/update.json"

    if [ -f "$mf" ] && command -v jq >/dev/null 2>&1; then
        sha=$(jq -r '.syncedSha // empty' "$mf")

        [ -n "$sha" ] && {
            printf '%s' "$(echo "$sha" | cut -c1-7)"
            return
        }
    fi

    printf 'unknown'
}

cmd_start() {
    if wd_up; then
        note "Watchdog already running"
    else
        start_wd
        act "Started" "Watchdog"
    fi
}

cmd_stop() {
    pkill -f "watchdog.sh" 2>/dev/null
    qs kill >/dev/null 2>&1
    act "Stopped" "Shell"
}

cmd_restart() {
    had_wd=no
    wd_up && had_wd=yes

    qs kill >/dev/null 2>&1
    sleep 0.4

    if [ "$had_wd" = yes ]; then
        is_up || qs -d >/dev/null 2>&1
    else
        start_wd
    fi

    act "Restarted" "Shell"
}

cmd_log() {
    exec qs log -f "$@"
}

cmd_update() {
    [ -f "$ENGINE" ] || die "Update engine missing ($ENGINE)"
    command -v python3 >/dev/null 2>&1 || die "Python3 not found"
    command -v jq >/dev/null 2>&1 || die "Jq not found"

    json=$(python3 "$ENGINE" check) || die "Update check failed"
    status=$(printf '%s' "$json" | jq -r '.status // "error"')

    case "$status" in
        devmode)
            note "Dev install, update with git pull"
            return 0
            ;;
        offline)
            die "Offline, can't reach the update remote"
            ;;
        noclone)
            die "No update clone yet, open the in-app updater once first"
            ;;
        ok)
            ;;
        *)
            die "$(printf '%s' "$json" | jq -r '.error // "Update check failed"')"
            ;;
    esac

    behind=$(printf '%s' "$json" | jq -r '.behind // 0')
    version=$(printf '%s' "$json" | jq -r '.version // ""')

    if [ "$behind" = 0 ]; then
        act "Up to date" "$version"
        return 0
    fi

    fromd=$(printf '%s' "$json" | jq -r '.fromDate // ""')
    tod=$(printf '%s' "$json" | jq -r '.toDate // ""')

    sec "$behind Commit(s) Behind"
    gap
    row "${faint}$fromd -> $tod${rst}"
    gap

    printf '%s' "$json" | jq -r '.changelog[]?' |
        while IFS= read -r line; do
            row "${flame}·${rst} ${cream}${line}${rst}"
        done

    deps=$(printf '%s' "$json" | jq -r '[.missingDeps[]?.name] | join(", ")')

    [ -n "$deps" ] && {
        gap
        row "${dim}New Packages${rst}   ${cream}${deps}${rst}"
    }

    conf=$(printf '%s' "$json" | jq -r '.conflicts | length')

    [ "$conf" -gt 0 ] 2>/dev/null && {
        gap
        row "${faint}${conf} Edited File(s) Clash With Upstream, Kept As You Have Them${rst}"
    }

    gap

    printf '  %s▌%s %sApply update?%s %s[Y/n]%s ' \
        "$verm" "$rst" "$cream" "$rst" "$dim" "$rst"

    read -r ans

    case "$ans" in
        "" | y | Y | yes | YES)
            ;;
        *)
            note "Skipped"
            return 0
            ;;
    esac

    ids=$(printf '%s' "$json" | jq -r '[.missingDeps[]?.id] | join(",")')

    if [ -n "$ids" ]; then
        result=$(python3 "$ENGINE" apply --install-deps "$ids") ||
            die "Apply failed"
    else
        result=$(python3 "$ENGINE" apply) ||
            die "Apply failed"
    fi

    nfail=$(printf '%s' "$result" | jq -r '.depFailures | length')

    if [ "$nfail" -gt 0 ] 2>/dev/null; then
        note "Some packages didn't install:"

        printf '%s' "$result" |
            jq -r '.depFailures[]? | .id + ": " + .error' |
            while IFS= read -r line; do
                row "${faint}·${rst} ${dim}${line}${rst}"
            done
    fi

    restart=$(printf '%s' "$result" | jq -r '.restartNeeded')
    [ "$restart" = true ] && cmd_restart

    act "Updated to" "$version"
}

cmd_status() {
    sec "Lumen"
    gap

    if is_up; then
        mk="${flame}●${rst}"
        lab="${cream}Shell${rst}"
        stt="${cream}Running${rst}"
    else
        mk="${faint}○${rst}"
        lab="${dim}Shell${rst}"
        stt="${dim}Stopped${rst}"
    fi

    if wd_up; then
        wdt="${dim}Watchdog Up${rst}"
    else
        wdt="${faint}No Watchdog${rst}"
    fi

    row "$mk $lab   $stt   $wdt"

    gap
    row "${dim}Version${rst}   ${cream}$(installed_version)${rst}"
    gap
}

cmd="$1"
[ $# -gt 0 ] && shift

case "$cmd" in
    restart) cmd_restart ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    log) cmd_log "$@" ;;
    update) cmd_update ;;
    status) cmd_status ;;
    "" | -h | --help | help) usage ;;
    *) die "Unknown command '$cmd' (try: lumen help)" ;;
esac