{
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/lantern.txt",
    "color": {
      "1": "38;2;182;109;222",
      "2": "38;2;233;201;253",
      "3": "38;2;12;31;65",
      "4": "38;2;16;35;70",
      "5": "38;2;167;178;195",
      "6": "38;2;81;104;145",
      "7": "38;2;240;245;255"
    },
    "padding": { "top": 1, "left": 2, "right": 6 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;182;109;222"
    },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[38;2;125;135;152m── system ──────────────" },
    { "type": "os", "key": "  os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "  kernel", "format": "{release}" },
    { "type": "uptime", "key": "  up" },
    { "type": "disk", "key": "  storage", "format": "{size-used} / {size-total} [{size-percentage}]" },
    { "type": "packages", "key": " 󰏖 pkgs", "format": "{all}" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;125;135;152m── rice ─────l───────────" },
    { "type": "wm", "key": "  wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "  shell", "format": "{exe-name}" },
    { "type": "terminal", "key": "  term", "format": "{pretty-name}" },
    { "type": "custom", "key": " 󰂜 bar", "format": "lumen (Quickshell)" },
    { "type": "custom", "key": "  font", "format": "JetBrains Mono Nerd" },
    { "type": "command", "key": " 󰸉 wall", "text": "basename \"$(cat ${XDG_STATE_HOME:-$HOME/.local/state}/lumen-wallpaper)\"" }
  ]
}
